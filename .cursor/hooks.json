{
  "version": 1,
  "_generated": "From harness.config.json by scripts/engine/sync.mjs. preToolUse exit 2 refuses a violating write.",
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .claude/hooks/harness-config-gate.mjs"
      },
      {
        "command": "node .claude/hooks/prompt-duplication-guard.mjs"
      }
    ],
    "preToolUse": [
      {
        "command": "node .claude/hooks/pre-validate-cypress-rules.mjs",
        "matcher": "Write|StrReplace"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .claude/hooks/validate-cypress-rules.mjs"
      }
    ],
    "stop": [
      {
        "command": "node .claude/hooks/session-end-reminder.mjs"
      }
    ]
  }
}
