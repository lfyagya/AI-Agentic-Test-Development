{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_generated": "From harness.config.json by scripts/engine/sync.mjs. Do not edit.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path'),u=require('node:url');const r=process.env.CURSOR_PROJECT_DIR||process.env.CLAUDE_PROJECT_DIR||process.cwd();import(u.pathToFileURL(p.join(r,'.claude','hooks',process.argv[1])).href)\" \"prompt-duplication-guard.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path'),u=require('node:url');const r=process.env.CURSOR_PROJECT_DIR||process.env.CLAUDE_PROJECT_DIR||process.cwd();import(u.pathToFileURL(p.join(r,'.claude','hooks',process.argv[1])).href)\" \"pre-validate-cypress-rules.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path'),u=require('node:url');const r=process.env.CURSOR_PROJECT_DIR||process.env.CLAUDE_PROJECT_DIR||process.cwd();import(u.pathToFileURL(p.join(r,'.claude','hooks',process.argv[1])).href)\" \"validate-cypress-rules.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path'),u=require('node:url');const r=process.env.CURSOR_PROJECT_DIR||process.env.CLAUDE_PROJECT_DIR||process.cwd();import(u.pathToFileURL(p.join(r,'.claude','hooks',process.argv[1])).href)\" \"session-end-reminder.mjs\""
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": true,
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(npm run cy:open*)",
      "Bash(npm run cy:run*)",
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(npm run harness:*)",
      "Bash(npx cypress*)",
      "Bash(grep -r* cypress/*)",
      "Bash(find cypress/*)"
    ],
    "deny": [
      "WebSearch"
    ]
  }
}
