{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "node .claude/hooks/harness-config-gate.mjs",
        "cwd": ".",
        "timeoutSec": 30,
        "env": {
          "HARNESS_GENERATED_FROM": "harness.config.json"
        }
      },
      {
        "type": "command",
        "command": "node .claude/hooks/prompt-duplication-guard.mjs",
        "cwd": ".",
        "timeoutSec": 30,
        "env": {
          "HARNESS_GENERATED_FROM": "harness.config.json"
        }
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "type": "command",
        "command": "node .claude/hooks/pre-validate-cypress-rules.mjs",
        "cwd": ".",
        "timeoutSec": 30,
        "env": {
          "HARNESS_GENERATED_FROM": "harness.config.json"
        }
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "type": "command",
        "command": "node .claude/hooks/validate-cypress-rules.mjs",
        "cwd": ".",
        "timeoutSec": 30,
        "env": {
          "HARNESS_GENERATED_FROM": "harness.config.json"
        }
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "command": "node .claude/hooks/session-end-reminder.mjs",
        "cwd": ".",
        "timeoutSec": 30,
        "env": {
          "HARNESS_GENERATED_FROM": "harness.config.json"
        }
      }
    ]
  }
}
