{
  "name": "cypress-automation-boilerplate",
  "version": "2.0.0",
  "description": "Production-ready Cypress automation boilerplate — Config → Custom Commands → Tests, with optional AI adapters.",
  "keywords": [
    "cypress",
    "automation",
    "testing",
    "e2e",
    "command-first",
    "boilerplate"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lfyagya/cypress-automation-boilerplate.git"
  },
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "node scripts/run-cypress.mjs all",
    "cy:run:smoke": "node scripts/run-cypress.mjs smoke",
    "cy:run:e2e": "node scripts/run-cypress.mjs e2e",
    "cy:run:tag": "node scripts/run-cypress.mjs all --",
    "cy:run:headed": "node scripts/run-cypress.mjs all -- --headed",
    "cy:run:cloud": "node scripts/run-cypress.mjs all",
    "check:rules": "node .claude/hooks/validate-cypress-rules.mjs --all",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run harness:check && npm run harness:test && npm run harness:format:check && npm run check:rules && npm test && npm run evidence:build",
    "harness:sync": "node scripts/harness/sync.mjs",
    "harness:check": "node scripts/harness/check-drift.mjs",
    "harness:compose": "node harness/profiles/bin/compose-harness-config.mjs --profile harness/profiles/projects/cypress-boilerplate.json --out harness.config.json",
    "harness:profile:verify": "node harness/profiles/bin/compose-harness-config.mjs --profile harness/profiles/projects/cypress-boilerplate.json --verify harness.config.json",
    "harness:profile:test": "node harness/profiles/bin/test-compose.mjs",
    "harness:format:check": "prettier --check harness.config.json harness/agents harness/qa-automation-foundations.md scripts/harness/test-policy-messages.mjs .claude/hooks/pre-validate-cypress-rules.mjs .claude/hooks/shared-rules.mjs .claude/hooks/validate-cypress-rules.mjs && prettier --check --print-width 100 scripts/harness/check-drift.mjs scripts/harness/sync.mjs scripts/harness/templates.mjs scripts/harness/test-agent-adapters.mjs",
    "harness:test": "node scripts/harness/test-policy-messages.mjs && node scripts/harness/test-agent-adapters.mjs && npm run harness:profile:test && npm run harness:profile:verify && npm run evidence:test && node scripts/test-run-cypress.mjs",
    "evidence:build": "node scripts/evidence.mjs --framework cypress --report cypress/reports/html/index.json",
    "evidence:record": "node scripts/record-evidence.mjs",
    "evidence:test": "node scripts/test-evidence.mjs && node scripts/test-record-evidence.mjs",
    "pretest": "npm run lint",
    "test": "npm run cy:run",
    "test:smoke": "npm run cy:run:smoke",
    "test:e2e": "npm run cy:run:e2e"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@cypress/grep": "^6.0.2",
    "@cypress/webpack-preprocessor": "^6.0.2",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^9.3.0",
    "@testing-library/cypress": "^10.0.3",
    "babel-loader": "^9.2.1",
    "cypress": "^15.3.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "cypress-real-events": "^1.13.0",
    "cypress-wait-until": "^2.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^3.6.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.7"
  },
  "author": "",
  "license": "ISC"
}
